# Sepolia Testnet Configuration
# Copy this file to .env and fill in your values

# Alchemy or Infura RPC URL for Sepolia
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key for deploying contracts and signing transactions (without 0x prefix or with)
SEPOLIA_PRIVATE_KEY=your_private_key_here

# Cosmos gRPC endpoint (local chain)
COSMOS_GRPC=http://localhost:9090

# Cosmos REST API endpoint (local chain)
COSMOS_REST=http://localhost:1317
